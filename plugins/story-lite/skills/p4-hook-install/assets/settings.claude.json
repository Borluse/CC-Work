{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"__PROJECT_ROOT__/.codex/hooks/p4-edit-hook.py\"",
            "timeout": 30000,
            "permission": "allow"
          }
        ]
      }
    ]
  }
}
